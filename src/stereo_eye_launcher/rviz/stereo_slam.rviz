# stereo_slam.rviz - RViz2 config for stereo_eye RTAB-Map SLAM in Gazebo.
# Loaded by launch.py with use_sim_time:=true. Fixed Frame is odom (wheel
# odometry from Gazebo), which exists as soon as the simulation runs; map
# only appears once rtabmap does.
# Hand-maintained: only non-default settings are listed; RViz fills in the rest.
# Note: "File > Save Config" in RViz rewrites this file with generated window
# state - don't commit that; edit this file by hand instead.

Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time

Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
    Background Color: 48; 48; 48

  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10

    # TF frame tree (map > vo > odom > base_footprint > camera frames)
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true

    # Robot model from robot_state_publisher (latched topic)
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable

    # Stereo camera images bridged from Gazebo (sensor QoS)
    - Class: rviz_default_plugins/Image
      Name: Left Image
      Enabled: true
      Topic:
        Value: /stereo/left/image_raw
        Reliability Policy: Best Effort

    - Class: rviz_default_plugins/Image
      Name: Right Image
      Enabled: true
      Topic:
        Value: /stereo/right/image_raw
        Reliability Policy: Best Effort

    # 2D occupancy grid from rtabmap (latched topic)
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable

    # 3D point cloud map from rtabmap
    - Class: rviz_default_plugins/PointCloud2
      Name: Cloud Map
      Enabled: true
      Style: Flat Squares
      Size (m): 0.02
      Color Transformer: AxisColor
      Topic:
        Value: /cloud_map

    # Visual odometry from rtabmap stereo_odometry (wheel odom is /wheel_odom)
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 100
      Topic:
        Value: /odom

    # Exploration (explore:=true only; without it these topics are absent
    # and the displays just show a warning).
    # Nav2 global costmap: rtabmap /map plus inflation around walls.
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Alpha: 0.4
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable

    # Frontiers found by explore_lite (blue = candidates, red = blacklisted,
    # green sphere = the chosen goal).
    - Class: rviz_default_plugins/MarkerArray
      Name: Frontiers
      Enabled: true
      Topic:
        Value: /explore/frontiers

    # Path the Nav2 planner computed to the current frontier
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Color: 25; 255; 0
      Topic:
        Value: /plan

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  # Orbit view centred on the robot: odom starts at the spawn pose, so the
  # robot begins at (0, 0) in the fixed frame (not its Gazebo world position).
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.6
      Yaw: 0.785
