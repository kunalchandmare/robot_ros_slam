    <visual name="eye_bezel_l">
      <origin rpy="0 1.570796326794895 0" xyz="0.048999999999999995 0.03 0.005"/>
      <geometry>
        <cylinder length="0.012" radius="0.035"/>
      </geometry>
      <material name="se_light_grey"/>
    </visual>
    <visual name="eye_bezel_r">
      <origin rpy="0 1.570796326794895 0" xyz="0.048999999999999995 -0.03 0.005"/>
      <geometry>
        <cylinder length="0.012" radius="0.035"/>
      </geometry>
      <material name="se_light_grey"/>
    </visual>
    <visual name="eye_glass_mid">
      <origin rpy="0 0 0" xyz="0.056499999999999995 0 0.005"/>
      <geometry>
        <box size="0.003 0.06 0.06"/>
      </geometry>
      <material name="se_glass"/>
    </visual>
    <visual name="eye_glass_l">
      <origin rpy="0 1.570796326794895 0" xyz="0.056499999999999995 0.03 0.005"/>
      <geometry>
        <cylinder length="0.003" radius="0.03"/>
      </geometry>
      <material name="se_glass"/>
    </visual>
    <visual name="eye_glass_r">
      <origin rpy="0 1.570796326794895 0" xyz="0.056499999999999995 -0.03 0.005"/>
      <geometry>
        <cylinder length="0.003" radius="0.03"/>
      </geometry>
      <material name="se_glass"/>
    </visual>
    <visual name="eye_sparkle">
      <origin rpy="0 0 0" xyz="0.057999999999999996 -0.010 0.022000000000000002"/>
      <geometry>
        <sphere radius="0.0055"/>
      </geometry>
      <material name="se_white"/>
    </visual>
    <visual name="cheek_l">
      <origin rpy="0 1.570796326794895 0" xyz="0.046 0.062 -0.038"/>
      <geometry>
        <cylinder length="0.003" radius="0.008"/>
      </geometry>
      <material name="se_blush"/>
    </visual>
    <visual name="cheek_r">
      <origin rpy="0 1.570796326794895 0" xyz="0.046 -0.062 -0.038"/>
      <geometry>
        <cylinder length="0.003" radius="0.008"/>
      </geometry>
      <material name="se_blush"/>
    </visual>
    <!-- twin antennas with blue bobbles -->
    <visual name="antenna_l">
      <origin rpy="-0.30 0 0" xyz="-0.010 0.050 0.0605"/>
      <geometry>
        <cylinder length="0.026" radius="0.003"/>
      </geometry>
      <material name="se_light_grey"/>
    </visual>
    <visual name="antenna_l_tip">
      <origin rpy="0 0 0" xyz="-0.010 0.055 0.0765"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="se_blue"/>
    </visual>
    <visual name="antenna_r">
      <origin rpy="0.30 0 0" xyz="-0.010 -0.050 0.0605"/>
      <geometry>
        <cylinder length="0.026" radius="0.003"/>
      </geometry>
      <material name="se_light_grey"/>
    </visual>
    <visual name="antenna_r_tip">
      <origin rpy="0 0 0" xyz="-0.010 -0.055 0.0765"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="se_blue"/>
    </visual>
    <collision name="head_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.09 0.245 0.095"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0011508333333333334" ixy="0" ixz="0" iyy="0.00028541666666666673" iyz="0" izz="0.0011354166666666665"/>
    </inertial>
  </link>
  <joint name="head_joint" type="fixed">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin rpy="0 0 0" xyz="0.0 0 0.1925"/>
  </joint>
  <!-- Rigid stereo bar: one body carrying both cameras, so the baseline / relative pose never changes.
       Origin = lens front plane, midway between the two lenses; x forward, y left, z up. -->
  <link name="stereo_bar_link">
    <visual name="lens_left">
      <origin rpy="0 1.570796326794895 0" xyz="-0.0025 0.04 0"/>
      <geometry>
        <cylinder length="0.003" radius="0.0075"/>
      </geometry>
      <material name="se_sky"/>
    </visual>
    <visual name="lens_right">
      <origin rpy="0 1.570796326794895 0" xyz="-0.0025 -0.04 0"/>
      <geometry>
        <cylinder length="0.003" radius="0.0075"/>
      </geometry>
      <material name="se_sky"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.015 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="6.5e-05" ixy="0" ixz="0" iyy="7.625e-06" iyz="0" izz="6.3625e-05"/>
    </inertial>
  </link>
  <joint name="stereo_bar_joint" type="fixed">
    <parent link="head_link"/>
    <child link="stereo_bar_link"/>
    <origin rpy="0 0 0" xyz="0.06099999999999999 0 0.005"/>
  </joint>
  <!-- Stereo-pair centre frame (x forward), kept for drivers/tools that expect camera_link -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="stereo_bar_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="camera_left_link"/>
  <joint name="camera_left_joint" type="fixed">
    <parent link="stereo_bar_link"/>
    <child link="camera_left_link"/>
    <origin rpy="0 0 0" xyz="0 0.04 0"/>
  </joint>
  <link name="camera_left_optical_frame"/>
  <joint name="camera_left_optical_joint" type="fixed">
    <parent link="camera_left_link"/>
    <child link="camera_left_optical_frame"/>
    <origin rpy="-1.570796326794895 0 -1.570796326794895" xyz="0 0 0"/>
  </joint>
  <link name="camera_right_link"/>
  <joint name="camera_right_joint" type="fixed">
    <parent link="stereo_bar_link"/>
    <child link="camera_right_link"/>
    <origin rpy="0 0 0" xyz="0 -0.04 0"/>
  </joint>
  <link name="camera_right_optical_frame"/>
  <joint name="camera_right_optical_joint" type="fixed">
    <parent link="camera_right_link"/>
    <child link="camera_right_optical_frame"/>
    <origin rpy="-1.570796326794895 0 -1.570796326794895" xyz="0 0 0"/>
  </joint>
  <gazebo reference="camera_left_link">
    <sensor name="stereo_left" type="camera">
      <always_on>true</always_on>
      <update_rate>24</update_rate>
      <visualize>false</visualize>
      <topic>stereo/left/image_raw</topic>
      <ignition_frame_id>camera_left_optical_frame</ignition_frame_id>
      <!-- Fortress (ign-sensors 6.2+) -->
      <gz_frame_id>camera_left_optical_frame</gz_frame_id>
      <!-- Garden/Harmonic (+ Fortress 6.8+ fallback) -->
      <camera name="stereo_left">
        <camera_info_topic>stereo/left/camera_info</camera_info_topic>
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
        <!-- No <distortion>: images are ideal pinhole, i.e. already rectified (R = identity). -->
        <lens>
          <intrinsics>
            <fx>343.49636753580074</fx>
            <fy>343.49636753580074</fy>
            <cx>320.0</cx>
            <cy>180.0</cy>
            <s>0</s>
          </intrinsics>
          <projection>
            <p_fx>343.49636753580074</p_fx>
            <p_fy>343.49636753580074</p_fy>
            <p_cx>320.0</p_cx>
            <p_cy>180.0</p_cy>
            <tx>0.0</tx>
            <ty>0</ty>
          </projection>
        </lens>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="camera_right_link">
    <sensor name="stereo_right" type="camera">
      <always_on>true</always_on>
      <update_rate>24</update_rate>
      <visualize>false</visualize>
      <topic>stereo/right/image_raw</topic>
      <ignition_frame_id>camera_right_optical_frame</ignition_frame_id>
      <!-- Fortress (ign-sensors 6.2+) -->
      <gz_frame_id>camera_right_optical_frame</gz_frame_id>
      <!-- Garden/Harmonic (+ Fortress 6.8+ fallback) -->
      <camera name="stereo_right">
        <camera_info_topic>stereo/right/camera_info</camera_info_topic>
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
        <!-- No <distortion>: images are ideal pinhole, i.e. already rectified (R = identity). -->
        <lens>
          <intrinsics>
            <fx>343.49636753580074</fx>
            <fy>343.49636753580074</fy>
            <cx>320.0</cx>
            <cy>180.0</cy>
            <s>0</s>
          </intrinsics>
          <projection>
            <p_fx>343.49636753580074</p_fx>
            <p_fy>343.49636753580074</p_fy>
            <p_cx>320.0</p_cx>
            <p_cy>180.0</p_cy>
            <tx>-27.47970940286406</tx>
            <ty>0</ty>
          </projection>
        </lens>
      </camera>
    </sensor>
  </gazebo>
  <!-- == IMU == -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <!-- Fortress (ign-sensors 6.2+) -->
      <gz_frame_id>imu_link</gz_frame_id>
      <!-- Garden/Harmonic (+ Fortress 6.8+ fallback) -->
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0009</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0009</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0009</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- == Front ToF (gpu_lidar) == -->
  <!-- Fortress ign-sensors6 GpuLidarSensor: Lidar::Load advertises
       ignition.msgs.LaserScan on the sensor topic, then GpuLidarSensor::Load
       advertises ignition.msgs.PointCloudPacked on <topic>/points.
       The Sensors system (already in apartment.sdf, render_engine ogre) drives
       this; the Contact system is not used. Topic is set at sensor level
       (unlike the old contact sensor).

       Range min is 0.01 m, max 0.30 m. Lidar::Clamp promotes any finite value
       below min up to range_min, so a 0.0 empty pixel looks like a hit at
       min. The 11 x 3 sample pattern (25 deg H, +/- 1 deg V) is there so a
       single bad ogre1 second-pass pixel is less likely to pin the whole
       scan at range_min. Geometry of this link is entirely behind the
       sensor origin (see stereo_eye.urdf.xacro). -->
  <gazebo reference="front_tof_link">
    <sensor name="front_tof" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <topic>/front_tof</topic>
      <ignition_frame_id>front_tof_link</ignition_frame_id>
      <!-- Fortress (ign-sensors 6.2+) -->
      <gz_frame_id>front_tof_link</gz_frame_id>
      <!-- Garden/Harmonic (+ Fortress 6.8+ fallback) -->
      <ray>
        <scan>
          <horizontal>
            <samples>11</samples>
            <resolution>1</resolution>
            <min_angle>-0.2181661564992912</min_angle>
            <max_angle>0.2181661564992912</max_angle>
          </horizontal>
          <vertical>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>-0.017453292519943295</min_angle>
            <max_angle>0.017453292519943295</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.01</min>
          <max>0.3</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>
  <!-- == Model plugins == -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.19</wheel_separation>
      <wheel_radius>0.065</wheel_radius>
      <!-- Limits (ign-gazebo6 DiffDrive.cc element names). These cap the *commanded*
           twist, so a hard teleop key press cannot slam the robot into a tip-over.
           Linear: walk-pace 0.3 m/s, 0.5 m/s^2 (the accel used in the support-polygon check).
           Angular: 1.0 rad/s, 1.5 rad/s^2. -->
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
      <max_linear_velocity>0.3</max_linear_velocity>
      <min_linear_velocity>-0.3</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!-- Unique name so the launch package can bridge this as a wheel-odometry guess
           without colliding with /tf. Relative name: ign-gazebo6 assigns it as-is
           (not under /model/<name>/); gz-transport then publishes the absolute /wheel_tf.
           odom is likewise published as /odom. frame_id / child_frame_id unchanged. -->
      <tf_topic>wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
