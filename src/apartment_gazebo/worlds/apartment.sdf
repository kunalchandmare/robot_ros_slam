<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="apartment">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Suggested mobile-robot spawn (living room, clear of furniture):
         xyz = 4.0 5.5 0.05   rpy = 0 0 0
         yaw = 0, facing +X toward the kitchen opening.
    -->

    <include>
      <uri>model://apartment_walls</uri>
      <name>apartment_walls</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://sofa</uri>
      <name>sofa</name>
      <pose>2.4 7.2 0.4 0 0 0</pose>
    </include>
    <include>
      <uri>model://coffee_table</uri>
      <name>coffee_table</name>
      <pose>2.4 6 0.2 0 0 0</pose>
    </include>
    <include>
      <uri>model://kitchen_counter</uri>
      <name>kitchen_counter</name>
      <pose>9.4 6.2 0.45 0 0 0</pose>
    </include>
    <include>
      <uri>model://bed</uri>
      <name>bed</name>
      <pose>8.7 1.05 0.25 0 0 0</pose>
    </include>
    <include>
      <uri>model://vanity</uri>
      <name>vanity</name>
      <pose>0.45 3 0.4 0 0 0</pose>
    </include>

  </world>
</sdf>
