<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="kitchen_counter">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.6 2.4 0.9</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.6 2.4 0.9</size></box>
        </geometry>
        <material>
          <!-- White base so the albedo texture shows its own colours
               (Gazebo multiplies the texture by diffuse), same as the walls. -->
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://kitchen_counter/materials/textures/counter_terrazzo.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
