[submodule "src/third_party/m-explore-ros2"]
	path = src/third_party/m-explore-ros2
	url = https://github.com/robo-friends/m-explore-ros2.git
	# Our patches/m-explore-ros2/*.patch change files inside it; do not show
	# those as changes of the main repo (the pinned commit stays 326cf8a).
	ignore = dirty
